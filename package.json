    "store-assets": "AUTOGROUP_SMOKE=1 wxt build && node scripts/store-assets.mjs && wxt build",
    "theme": "node --no-warnings --experimental-loader ./scripts/js-extension-loader.mjs scripts/generate-theme.mjs"
  },
